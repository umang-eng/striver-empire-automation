# --- Vercel Next.js Server-Side Proxy Config ---
# Set PYTHON_WORKER_URL in Vercel Project Settings to your deployed Python Playwright worker URL
PYTHON_WORKER_URL=http://127.0.0.1:8000
BACKEND_API_KEY=change-me-to-a-long-random-secret

# --- Python Worker API & Security ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-vercel-app.vercel.app
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Core Scraper / CLI Overrides ---
STRIVER_BASE_URL=https://striverempire.com
STRIVER_HEADLESS=true
STRIVER_TIMEOUT_MS=30000
STRIVER_REQUEST_DELAY_SECONDS=0.4
STRIVER_LOG_LEVEL=INFO
STRIVER_OUTPUT_DIR=output

# --- Persistent Job Store (PostgreSQL in production; SQLite local fallback if unset) ---
# DATABASE_URL=postgresql://user:password@host:5432/striver_jobs

# --- Persistent Object Storage (choose S3-compatible OR Vercel Blob; local output/ if unset) ---
# S3_BUCKET=striver-reports
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BLOB_READ_WRITE_TOKEN=
